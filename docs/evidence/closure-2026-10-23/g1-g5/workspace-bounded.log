#!/usr/bin/env bash
_humoco() {
    local cur prev words cword
    _init_completion || return
    COMPREPLY=( $(compgen -W "init keygen run status peers quota doctor peer locks lock qr backup revoke completions stop config db restore" -- "$cur") )
}
complete -F _humoco humoco
#compdef humoco
_humoco() {
    local -a commands
    commands=(init keygen run status peers quota doctor peer locks lock qr backup revoke completions stop config db restore)
    _describe 'command' commands
}
_humoco "$@"
# fish completion for humoco
complete -c humoco -a init -d 'subcommand'
complete -c humoco -a keygen -d 'subcommand'
complete -c humoco -a run -d 'subcommand'
complete -c humoco -a status -d 'subcommand'
complete -c humoco -a peers -d 'subcommand'
