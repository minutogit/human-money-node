complete -c humoco -a qr -d 'subcommand'
complete -c humoco -a backup -d 'subcommand'
complete -c humoco -a revoke -d 'subcommand'
complete -c humoco -a completions -d 'subcommand'
complete -c humoco -a stop -d 'subcommand'
complete -c humoco -a config -d 'subcommand'
complete -c humoco -a db -d 'subcommand'
complete -c humoco -a restore -d 'subcommand'
Register-ArgumentCompleter -Native -CommandName humoco -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    @('init', 'keygen', 'run', 'status', 'peers', 'quota', 'doctor', 'peer', 'locks', 'lock', 'qr', 'backup', 'revoke', 'completions', 'stop', 'config', 'db', 'restore') | Where-Object { $_ -like "$wordToComplete*" }
}
set edit:completion:arg-completer[humoco] = {|@words|
